{
  "name": "projectwatch",
  "version": "1.0.0",
  "private": true,
  "description": "ProjectWatch Rwanda — AI-Powered Geospatial Intelligence Platform for Infrastructure Monitoring (MVP: road construction monitoring).",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
